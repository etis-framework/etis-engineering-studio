ETIS_ENV=development
ETIS_DATABASE_URL=sqlite:///./etis-studio.db
ETIS_WEB_ORIGIN=http://localhost:8000
ETIS_SESSION_SECRET=change-me-to-a-long-random-value
ETIS_DEV_LOGIN=true
ETIS_COURSE_NAMESPACE=COMP330-F26
ETIS_INSTRUCTOR_GITHUB=woconnell1

# Production-acceptance test student.
# Leave the identity values blank for normal development. Production values
# belong in the protected GitHub production environment, not source control.
# Authorization uses the exact Entra Object ID and does not allow gmail.com generally.
ETIS_PRODUCTION_TEST_STUDENT_OID=
ETIS_PRODUCTION_TEST_STUDENT_EMAIL=
ETIS_PRODUCTION_TEST_STUDENT_ID=production-test-student
ETIS_PRODUCTION_TEST_SECTION_KEY=PRODUCTION-TEST
ETIS_PRODUCTION_TEST_TEAM_KEY=production-test-team

# GitHub OAuth (student/instructor sign in)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Repository evidence access.
# Private repositories require a GitHub App installation; PATs are not supported.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# AI provider. Required for the natural reviewer conversation.
# The Studio intentionally does not pretend that deterministic fallback is equivalent coaching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Feature switches
ETIS_AI_ENABLED=true
ETIS_REPO_REFRESH_SECONDS=300
ETIS_MAX_REPO_FILE_BYTES=262144
ETIS_MAX_AI_CONTEXT_CHARS=32000
ETIS_AI_TIMEOUT_SECONDS=60
ETIS_SEMANTIC_CONVERSATION=true
ETIS_DIRECT_TEACH_AFTER_STALL_TURNS=2
ETIS_CONVERSATION_CRITIC=true
