ETIS_ENV=development
ETIS_DATABASE_URL=sqlite:///./etis-studio.db
ETIS_WEB_ORIGIN=http://localhost:8000
ETIS_SESSION_SECRET=change-me-to-a-long-random-value
ETIS_DEV_LOGIN=true
ETIS_COURSE_NAMESPACE=COMP330-F26
ETIS_INSTRUCTOR_GITHUB=woconnell1

# Microsoft Entra sign-in. Authentication uses the organizational multitenant
# authority; application admission remains restricted to the exact trusted
# institutional tenant UUID and allowed email domain.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/entra/callback
ENTRA_AUTHORITY=organizations
ENTRA_ALLOWED_TENANT_ID=
ENTRA_ALLOWED_DOMAIN=luc.edu

# Required only while upgrading identity rows created before tenant-scoped
# bindings. Set this to the tenant UUID that issued those existing OIDs.
ENTRA_LEGACY_PROVIDER_TENANT_ID=
# Optional comma-separated exact roster emails approved for a one-time move
# from a legacy guest object to the institutional home-tenant identity.
ENTRA_LEGACY_REBIND_EMAILS=

# Production-acceptance test student.
# Leave the identity values blank for normal development. Production values
# belong in the protected GitHub production environment, not source control.
# Authorization uses the exact Entra tenant ID plus exact Entra Object ID and
# does not allow gmail.com generally. Operators start this B2B guest-only
# acceptance flow at /auth/entra/production-test; the normal /auth/entra path
# remains Loyola-only.
ETIS_PRODUCTION_TEST_STUDENT_TENANT_ID=
ETIS_PRODUCTION_TEST_STUDENT_OID=
ETIS_PRODUCTION_TEST_STUDENT_EMAIL=
ETIS_PRODUCTION_TEST_STUDENT_ID=production-test-student
ETIS_PRODUCTION_TEST_SECTION_KEY=PRODUCTION-TEST
ETIS_PRODUCTION_TEST_TEAM_KEY=production-test-team

# GitHub OAuth (student/instructor sign in)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Repository evidence access.
# Private repositories require a GitHub App installation; PATs are not supported.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# AI provider. Required for the natural reviewer conversation.
# The Studio intentionally does not pretend that deterministic fallback is equivalent coaching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Optional. Empty uses OPENAI_CRITIC_MODEL, then OPENAI_MODEL, for shadow reasoning validation.
OPENAI_REASONING_VALIDATOR_MODEL=
# Optional. Empty uses OPENAI_CRITIC_MODEL, then OPENAI_MODEL, for shadow review planning.
OPENAI_REVIEW_PLANNER_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Feature switches
ETIS_AI_ENABLED=true
ETIS_REPO_REFRESH_SECONDS=300
ETIS_MAX_REPO_FILE_BYTES=262144
ETIS_MAX_AI_CONTEXT_CHARS=32000
ETIS_AI_TIMEOUT_SECONDS=60
ETIS_SEMANTIC_CONVERSATION=true
ETIS_DIRECT_TEACH_AFTER_STALL_TURNS=2
ETIS_CONVERSATION_CRITIC=true
# v0.17 PR2 supports legacy or shadow. Shadow affects new review sessions only.
ETIS_REASONING_VALIDATION_MODE=legacy
# v0.17 PR3 supports legacy or shadow. Planning shadow requires reasoning shadow.
ETIS_REVIEW_PLANNING_MODE=legacy
